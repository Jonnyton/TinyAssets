# Node / Capacitor CLI (package-lock.json IS tracked: CI installs with `npm ci`)
node_modules/

# Generated native Android project (regenerate with `npx cap add android`).
# If you customize it (icons, signing config, native code) and want it tracked,
# remove this line and commit the android/ directory.
/android/

# Generated native iOS project (regenerate with `npx cap add ios`). Every
# customization is applied by scripts/add_ios_scheme.py and add_ios_assets.py.
/ios/

# `container/build.sh` moves an existing android/ aside instead of deleting it
# (Hard Rule 13). Those snapshots are generated native code and must not become
# untracked noise in a public repo.
/android.superseded.*/

# Build outputs
*.apk
*.aab
*.keystore
*.jks
.gradle/
build/

# Capacitor assets source is tracked; generated icons live under android/
