{
  "daily_fact_pattern": "per[ _-]?day|daily|\\b[rt]pd\\b",
  "shorter_window_pattern": "(?<![a-z])per[ _-]?(?:minute|second|hour|min|sec)\\b|\\b[rt]p[msh]\\b",
  "balance_pattern": "\\b(?:remaining|left)\\b",
  "exhausted_pattern": "exceed|reach|exhaust|used up",
  "sentence_split_pattern": "(?<=[.!?;])(?:\\s+|(?=[A-Z]))|\\n",
  "fact_paths": [
    ["message"],
    ["code"],
    ["details", "*", "violations", "*", "quotaId"],
    ["details", "*", "violations", "*", "quotaMetric"]
  ],
  "nested_headers_path": ["metadata", "headers"],
  "daily_windows": [
    {"remaining": "x-ratelimit-remaining-requests-day", "reset": "x-ratelimit-reset-requests-day"},
    {"remaining": "x-ratelimit-remaining-requests-per-day", "reset": "x-ratelimit-reset-requests-per-day"},
    {"remaining": "x-ratelimit-remaining-tokens-day", "reset": "x-ratelimit-reset-tokens-day"},
    {"remaining": "x-ratelimit-remaining-tokens-per-day", "reset": "x-ratelimit-reset-tokens-per-day"}
  ],
  "declared_daily_window": {
    "remaining": "x-ratelimit-remaining-requests",
    "reset": "x-ratelimit-reset-requests"
  },
  "epoch_reset_header": "x-ratelimit-reset"
}
