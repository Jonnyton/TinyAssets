### .github/workflows/auto-enroll-merge.yml
   1: name: Auto-enroll merge
   2: 
   3: # Why this exists
   4: # ---------------
   5: # Branch protection + repo auto-merge only get you so far: SOMEONE still has to
   6: # enroll each PR with `gh pr merge --auto`. That left a human (or an agent that
   7: # cannot merge) in the loop for every single PR, which defeats the point.
   8: #
   9: # This workflow does the enrolling. From here: open a PR, and when its required
  10: # checks go green GitHub merges it. No human step, no agent step.
  11: #
  12: # Safety is delegated to branch protection, which is the right place for it:
  13: #   - required checks `policy` and `Diff scope declared` must pass
  14: #   - `strict` means the branch must be current with main
  15: #   - a PR that fails ANY required check simply never merges; enrolment is not a
  16: #     bypass, it is a standing instruction to merge WHEN allowed
  17: #
  18: # The scope guard is what makes this safe to automate. Without it, auto-enrolment
  19: # would have merged PR #1491 â€” 386 files including deploy-prod.yml and Dockerfile,
  20: # presented as a two-file auth fix, with CI green on everything it looked at.
  21: 
  22: on:
  23:   # pull_request_target so this always runs the trusted copy from the default
  24:   # branch and has a token that can enrol. We never check out or execute PR code.
  25:   pull_request_target:
  26:     types: [opened, reopened, ready_for_review, synchronize, edited, labeled, unlabeled]
  27: 
  28: permissions:
  29:   contents: write
  30:   pull-requests: write
  31: 
  32: concurrency:
  33:   group: auto-enroll-${{ github.event.pull_request.number }}
  34:   cancel-in-progress: true
  35: 
  36: jobs:
  37:   enroll:
  38:     name: Enroll for auto-merge
  39:     runs-on: ubuntu-latest
  40:     timeout-minutes: 5
  41:     # Forks are excluded deliberately: a fork PR is untrusted contribution and
  42:     # should not carry a standing merge instruction. Drafts are excluded because
  43:     # draft means "not finished" â€” marking ready fires `ready_for_review` and
  44:     # enrols it then.
  45:     if: >-
  46:       github.event.pull_request.draft == false &&
  47:       github.event.pull_request.head.repo.full_name == github.repository &&
  48:       github.event.pull_request.base.ref == 'main'
  49:     steps:
  50:       - name: Check out trusted enrollment policy
  51:         uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
  52:         with:
  53:           ref: ${{ github.event.pull_request.base.sha }}
  54:           persist-credentials: false
  55: 
  56:       - name: Enable auto-merge
  57:         env:
  58:           GH_TOKEN: ${{ github.token }}
  59:           PR: ${{ github.event.pull_request.number }}
  60:           REPO: ${{ github.repository }}
  61:         shell: bash
  62:         run: |
  63:           set -euo pipefail
  64: 
  65:           PR_JSON="$(gh pr view "$PR" --repo "$REPO" \
  66:             --json autoMergeRequest,body,headRefName,headRefOid)"
  67:           STATE="$(jq -r \
  68:             'if .autoMergeRequest == null then "no" else "yes" end' \
  69:             <<<"$PR_JSON")"
  70:           HEAD_REF="$(jq -r '.headRefName' <<<"$PR_JSON")"
  71:           HEAD_OID="$(jq -r '.headRefOid' <<<"$PR_JSON")"
  72:           jq -r '.body // ""' <<<"$PR_JSON" > "$RUNNER_TEMP/pr-body.md"
  73: 
  74:           if python scripts/drain_review_gate.py \
  75:               --branch "$HEAD_REF" \
  76:               --head "$HEAD_OID" \
  77:               --body-file "$RUNNER_TEMP/pr-body.md"; then
  78:             REVIEW_GATE="allow"
  79:           else
  80:             REVIEW_GATE="deny"
  81:           fi
  82: 
  83:           if [ "$REVIEW_GATE" = "deny" ]; then
  84:             if [ "$STATE" = "yes" ]; then
  85:               gh pr merge "$PR" --repo "$REPO" --disable-auto
  86:               echo "Disabled stale or unreviewed drain auto-merge."
  87:             else
  88:               echo "Drain PR remains unenrolled pending exact-head review."
  89:             fi
  90:             {
  91:               echo "### Auto-merge"
  92:               echo ""
  93:               echo "Not enrolled: drain PR needs exactly one current review receipt:"
  94:               echo "\`Drain-Review-Verdict: APPROVE\`"
  95:               echo "\`Drain-Review-Head: <40-character lowercase head SHA>\`"
  96:               echo "\`Drain-Review-Artifact: <docs path or GitHub URL>\`"
  97:             } >> "$GITHUB_STEP_SUMMARY"
  98:             exit 0
  99:           fi
 100: 
 101:           # Idempotent: re-running on a later event is a no-op if already enrolled.
 102:           if [ "$STATE" = "yes" ]; then
 103:             echo "PR #${PR} is already enrolled for auto-merge."
 104:             echo "already enrolled" >> "$GITHUB_STEP_SUMMARY"
 105:             exit 0
 106:           fi
 107: 
 108:           # `|| true`: enrolment can legitimately fail â€” e.g. the PR is already
 109:           # mergeable and protection is satisfied, or the branch is behind. Those
 110:           # are not this workflow's problem and must not fail the PR's checks.
 111:           if gh pr merge "$PR" --repo "$REPO" --auto --squash \
 112:               --match-head-commit "$HEAD_OID" 2>err.txt; then
 113:             echo "PR #${PR} enrolled for auto-merge (squash)."
 114:             {
 115:               echo "### Auto-merge"
 116:               echo ""
 117:               echo "Enrolled. This PR will merge itself once required checks pass:"
 118:               echo "\`policy\` and \`Diff scope declared\`."
 119:             } >> "$GITHUB_STEP_SUMMARY"
 120:           else
 121:             echo "Could not enrol PR #${PR} â€” not fatal, leaving it to the humans:"
 122:             sed 's/^/    /' err.txt || true
 123:             {
 124:               echo "### Auto-merge"
 125:               echo ""
 126:               echo "Could not enrol automatically. This does not block the PR."
 127:               echo ""
 128:               echo '```'
 129:               cat err.txt || true
 130:               echo '```'
 131:             } >> "$GITHUB_STEP_SUMMARY"
 132:           fi
 133: 
 134: # Note on blast radius
 135: # --------------------
 136: # This makes merging the DEFAULT for any non-draft, same-repo PR targeting main.
 137: # The protection against a bad merge is entirely the required-check set, so those
 138: # checks are now load-bearing in a way they were not before. Weakening or removing
 139: # a required check silently widens what merges itself â€” treat changes to
 140: # `policy` or `Diff scope declared` as changes to the merge policy itself.
