name: Tests

# Why this exists
# ---------------
# Until this workflow landed, NEITHER required status check on `main` tested code
# behaviour:
#
#   * `policy` (daemon-request-policy.yml) only reads writer:/checker: labels. A
#     PR carrying none of them passes it trivially.
#   * `Diff scope declared` (pr-scope-guard.yml) is a scope-DECLARATION gate and
#     says so in its own honesty note.
#
# Since the repo auto-merges any non-draft PR once required checks pass, and
# merges flow on to production, code could reach live users without a single
# behavioural gate. This workflow is that gate.
#
# MUST run unconditionally — no `paths:` filter, no job-level `if:`.
# A REQUIRED status check that is path-filtered never reports at all on PRs
# outside those paths, and the PR then hangs forever on "Expected — waiting for
# status". That is why `lint`/actionlint is path-filtered and must NEVER be made
# required. Every `exit` path below produces a conclusion for the same check name.

on:
  pull_request:
    # No `paths:` — see above. Drafts get `opened`/`synchronize` too, so the gate
    # gives signal before a PR is marked ready and becomes auto-merge eligible.
    types: [opened, reopened, synchronize, ready_for_review]
  push:
    branches: [main]
  workflow_dispatch:

# `pull_request`, deliberately NOT `pull_request_target`: testing a PR means
# EXECUTING the PR's code, so it must run in the untrusted-by-default context
# where the token is read-only and secrets are withheld. The scope guard uses
# _target for the opposite reason — it only reads metadata and must not be
# editable by the PR it judges.
permissions:
  contents: read

concurrency:
  # PRs cancel superseded runs (only the latest head matters). Main pushes are
  # keyed per-SHA and NEVER cancel: grouping them by ref meant each push killed
  # the previous main run, so with a commit every ~10 min the post-merge
  # tripwire almost never finished — it looked like coverage while providing
  # none (found in cross-family review 2026-08-03).
  group: tests-${{ github.event.pull_request.number || github.sha }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  required-tests:
    # This exact string is the branch-protection context. Renaming the job
    # ORPHANS the old required context: it stays "Expected — waiting for
    # status" forever and every PR blocks indefinitely (it does NOT fail open;
    # corrected 2026-08-02 per Codex review). Change the name only together
    # with the `gh api` protection update in
    # docs/decisions/ADR-003-required-test-aggregator.md.
    name: required-tests
    runs-on: ubuntu-latest
    # 30 was measured against the 2026-07-22 suite (25:48) and the suite has
    # since outgrown it — run 30766011005 was killed at exactly 30:15 with the
    # tests still going. 50 buys headroom for one honest full measurement; the
    # ADR documents the fast-subset escape hatch if the latency bites.
    timeout-minutes: 50

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
          cache-dependency-path: pyproject.toml

      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e '.[dev]'

      - name: Run the required test surface
        env:
          # Keep the suite off the real repo tree and off any host state. The
          # conftest already forces mock providers and sqlite_only storage; this
          # is belt-and-braces for anything that reads the env directly.
          TINYASSETS_DATA_DIR: ${{ runner.temp }}/ta-data
        run: |
          mkdir -p "$TINYASSETS_DATA_DIR"
          # The script owns the pytest invocation AND the pass/fail decision:
          # it fails on any failure not listed in .github/known-failing-tests.txt.
          # No `|| true`, no `continue-on-error` — its exit code IS the gate.
          #
          # --exclude-from drops the 47 files holding ~90% of the wall clock,
          # taking this from ~37 min to ~4. That matters because `strict`
          # protection requires a PR to be up to date at merge time and main
          # takes a commit every ~10 min: at 37 min only 5% of gaps are long
          # enough to land anything, which would wedge every merge including
          # the drain. At ~4 min, 79% are.
          #
          # Excluding them was VERIFIED safe, not assumed: every failure the
          # exclusion run reported was also failing in the same-tree full run.
          # The excluded files still run in `full-tests` on every main push.
          python scripts/ci_required_tests.py --junit junit.xml \
            --exclude-from .github/heavy-test-files.txt \
            --min-ran 10700

      - name: Upload junit
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: junit-required-tests
          path: junit.xml
          if-no-files-found: warn

  # The other half of the split: the COMPLETE surface, on every main push.
  # NOT required — this is the post-merge tripwire, not the merge gate. It
  # exists because `required-tests` deliberately trades coverage for a wall
  # clock that fits main's commit cadence; without this the excluded files
  # would have no CI at all. Same quarantine ledger, so a failure here is a
  # real regression rather than baseline noise.
  full-tests:
    name: full-tests
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
          cache-dependency-path: pyproject.toml
      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e '.[dev]'
      - name: Run the complete test surface
        env:
          TINYASSETS_DATA_DIR: ${{ runner.temp }}/ta-data-full
        run: |
          mkdir -p "$TINYASSETS_DATA_DIR"
          # No --exclude-from: this is everything.
          python scripts/ci_required_tests.py --junit junit-full.xml --min-ran 12800
      - name: Upload junit
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: junit-full-tests
          path: junit-full.xml
          if-no-files-found: warn

  # NOT a required check (yet). The repo's `slow` marker guards stress/race
  # tests, and `required-tests` deselects them to stay fast — which left the 9
  # concurrency tests in test_activity_log_parity.py and test_node_bid_claim_stress.py
  # with NO CI runner at all, against an AGENTS.md rule that uptime work ships
  # with a concurrency/load proof. This job gives them one. It is reported but
  # not required until it has a clean track record, because stress tests are the
  # likeliest source of flake and a flaky REQUIRED check trains people to
  # re-run until green — which is how a gate stops meaning anything.
  slow-tests:
    name: slow-tests
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
          cache-dependency-path: pyproject.toml
      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e '.[dev]'
      - name: Run slow/stress/race tests
        env:
          TINYASSETS_DATA_DIR: ${{ runner.temp }}/ta-data-slow
        run: |
          mkdir -p "$TINYASSETS_DATA_DIR"
          # Serial on purpose: these assert cross-process/locking behaviour and
          # sharing a worker pool with them would test the pool, not the code.
          # Both ignores are tray imports that die at COLLECTION on a headless
          # runner (Xlib "Bad display name") and take the whole job down with
          # an Interrupted — required-tests survives the same files only via
          # --continue-on-collection-errors.
          pytest -m slow -q --no-header -rfE --durations=10 \
            --ignore=tests/test_tinyassets_tray.py \
            --ignore=tests/desktop_install/test_packaged_runtime.py

