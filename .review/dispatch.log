  54:     Regression guard for bug (2) above. `push: branches: [main]` is allowed to
  55:     stay â€” it still catches the rare human-PAT merge â€” but it must never be the
  56:     ONLY non-PR trigger, or the full suite reverts to never running.
  57:     """
  58:     triggers = _triggers(_load())
  59:     non_pr = set(triggers) - {"pull_request", "pull_request_target", "push"}
  60:     assert non_pr, (
  61:         "tests.yml has no trigger that fires on an app-performed merge. "
  62:         "`push: branches: [main]` does NOT fire when auto-merge lands a PR "
  63:         "via GITHUB_TOKEN, so the full-tests tripwire would never run. "
  64:         "Add `schedule:` (or another non-push trigger) back."
  65:     )
  66:     assert "schedule" in triggers, (
  67:         "expected `schedule:` specifically â€” it is the trigger empirically "
  68:         "proven to fire on this repo"
  69:     )
  70: 
  71: 
  72: def test_full_tests_job_runs_on_the_scheduled_trigger() -> None:
  73:     """A schedule trigger is useless if the job's `if:` excludes it."""
  74:     job = _load()["jobs"]["full-tests"]
  75:     condition = str(job.get("if", ""))
  76:     assert "pull_request" in condition, (
  77:         "full-tests should be gated on event name, not run everywhere"
  78:     )
  79:     # The guard must EXCLUDE pull_request, not require it â€” `== 'pull_request'`
  80:     # would flip the meaning and strand the tripwire again.
  81:     assert "!=" in condition, (
  82:         f"full-tests `if:` must exclude pull_request, got: {condition!r}"
  83:     )
  84: 
  85: 
  86: def test_main_runs_are_not_cancelled_by_later_pushes() -> None:
  87:     """Regression guard for bug (1): per-SHA grouping, no cancel off PRs."""
  88:     concurrency = _load()["concurrency"]
  89:     assert "github.sha" in concurrency["group"], (
  90:         "main runs must be keyed per-SHA; grouping by ref lets each push "
  91:         "cancel the previous main run"
  92:     )
  93:     assert "pull_request" in str(concurrency["cancel-in-progress"]), (
  94:         "cancel-in-progress must be conditional on the event being a "
  95:         "pull_request; `true` would cancel main runs too"
  96:     )
  97: 
  98: 
  99: def test_required_tests_job_name_matches_the_protection_context() -> None:
 100:     """Renaming this job orphans the required context and blocks every PR.
 101: 
 102:     It does not fail open: the old context stays "Expected â€” waiting for
 103:     status" forever.
 104:     """
 105:     assert _load()["jobs"]["required-tests"]["name"] == "required-tests"
 106: 
 107: 
 108: def test_required_tests_is_not_path_filtered() -> None:
 109:     """A path-filtered REQUIRED check never reports on out-of-path PRs."""
 110:     triggers = _triggers(_load())
 111:     assert "paths" not in (triggers.get("pull_request") or {}), (
 112:         "a `paths:` filter on the required check's trigger hangs every PR "
 113:         "outside those paths on 'Expected â€” waiting for status'"
 114:     )
