# Pressure-triggered recoverable daemon image cache retention only.
# Same policy and serialization as hourly cleanup; no broad Docker prune.

[Unit]
Description=TinyAssets bounded daemon image retention (weekly)
Documentation=https://github.com/Jonnyton/TinyAssets/blob/main/deploy/hetzner-bootstrap.sh
After=docker.service

[Service]
Type=oneshot
SuccessExitStatus=1
EnvironmentFile=/etc/tinyassets/env
WorkingDirectory=/opt/tinyassets-host-uptime/current
ExecStart=/usr/bin/python3 /opt/tinyassets-host-uptime/current/scripts/disk_autoprune.py --apply
TimeoutStartSec=180s
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tinyassets-prune
